#### Options

# Defaults
opt_verbose=
opt_debug=
opt_json=
opt_allow_expensive_scan=
opt_credential_policy=if-faster
opt_tag_scan=
opt_tag_resolution=auto
docker_hub_token=
json_results=

function usage {
    cat <<END
Usage: $SCRIPT_NAME [-h|--help] [-v|--verbose] [-d|--debug] [--json] [--allow-expensive-scan]
                    [--tag-resolution mode] [--tag-scan mode] [--credential-policy policy]
                    <container-or-image-or-digest> [...]
        -h|--help: get help
        -v|--verbose: turn on verbose mode
        -d|--debug: turn on debug mode; could trigger more requests
            to find get more error details from registries
        --json: write one JSON array containing all results to stdout
        --allow-expensive-scan: permit an expensive non-interactive per-tag registry scan
        --tag-resolution: select the baseline for an image tag (default: $opt_tag_resolution):
            auto: use a local image when present; otherwise resolve the tag remotely
            local: require a local image as the baseline
            remote: ignore local Docker state and resolve the tag through the registry
        --tag-scan: control the reverse lookup after resolving the baseline digest:
            ask: prompt to choose a bounded or exhaustive scan
            never: do not perform a reverse tag lookup
            any: stop after finding the first matching tag, even if it is floating
            any-durable: stop after finding one matching tag heuristically assumed durable;
                a directly confirmed durable baseline tag satisfies this without a scan
            all: scan for every matching remote tag
            The default is 'ask' with an interactive terminal; 'any-durable' otherwise or with --json
        --credential-policy: control when registry credentials may be used
                    (default: $opt_credential_policy):
            never: use only public/anonymous access
            if-required: start public; use credentials only after an explicit access denial
            if-faster: use credentials proactively only for a materially faster or more complete
                native path; otherwise authenticate only after an explicit access denial
            require: use only credentialed access; do not make public/anonymous requests

For a local baseline, its known tag is checked first. Interactive runs then ask
whether to stop at any matching tag, stop at a durable match, or find all matching tags;
non-interactive runs stop after a durable match unless another mode is specified.
Expensive interactive per-tag registry scans print an advisory and continue.
Expensive non-interactive scans fail fast unless '--allow-expensive-scan' is
specified. Public generic OCI registries use parallel manifest HEAD requests;
Skopeo remains the fallback for private or incompatible registries.
Docker Hub scans start anonymously. Set environment variables 'DOCKER_HUB_USERNAME'
and 'DOCKER_HUB_PAT' to exchange a Hub PAT for an in-memory access token without
prompting; these credentials keep the fast Hub API ahead of any Skopeo fallback.
If deeper pagination requires sign-in, an interactive run offers that fast retry
and any available slower Skopeo fallback together.
Private registry access reuses credentials configured by docker login, skopeo
login, or podman login. Conditional modes request short-lived tokens from az,
gcloud, or aws only after access denial, except when 'if-faster' selects a
materially faster credentialed provider API. Credential values are never passed
on this command line.

Arguments are interpreted as follows:
    - repository@sha256:... → use this registry digest exactly
    - repository:* → check every local tag for that repository (not supported in remote mode)
    - repository:tag → resolve this exact tag using the selected tag-resolution mode
    - repository → use the selected mode with an implicit ':latest';
        auto/local can broaden a missing ':latest' to local 'repository:*'
    - SHA-like value → try a local container ID, then a local image ID, then a registry digest
    - any other value → in auto/local mode, try a container name before treating
        it as a repository; remote mode always treats it as a repository
END
}

opts=$("$GETOPT" --options hvd --long help,verbose,debug,json,allow-expensive-scan,tag-resolution:,tag-scan:,credential-policy: --name "$SCRIPT_NAME" -- "$@") || { usage >&2; exit 2; }
eval set -- "$opts"

while true; do
    case "$1" in
        -h | --help) usage; exit 0 ;;
        -v | --verbose) opt_verbose=opt_verbose; shift ;;
        -d | --debug) opt_debug=opt_debug; shift ;;
        --json) opt_json=opt_json; shift ;;
        --allow-expensive-scan) opt_allow_expensive_scan=opt_allow_expensive_scan; shift ;;
        --tag-resolution) opt_tag_resolution="$2"; shift 2 ;;
        --tag-scan) opt_tag_scan="$2"; shift 2 ;;
        --credential-policy) opt_credential_policy="$2"; shift 2 ;;
        --) shift; break ;;
        *) abort "🐛 INTERNAL: unrecognized option '$1'" ;;
    esac
done

case "$opt_credential_policy" in
never | if-required | if-faster | require) ;;
*) abort "--credential-policy must be 'never', 'if-required', 'if-faster', or 'require'" ;;
esac

case "$opt_tag_scan" in
'' | ask | never | any | any-durable | all) ;;
*) abort "--tag-scan must be 'ask', 'never', 'any', 'any-durable', or 'all'" ;;
esac

case "$opt_tag_resolution" in
auto | local | remote) ;;
*) abort "--tag-resolution must be 'auto', 'local', or 'remote'" ;;
esac

if [[ "$opt_tag_resolution" != remote ]] && ! command -v "$DOCKER" &>/dev/null; then
    echo "$0: ERROR: \`$_install_cmd docker\` to install $DOCKER." >&2
    exit 1
fi

if [[ -z "$opt_tag_scan" ]]; then
    if [[ -n "$opt_json" ]]; then
        opt_tag_scan=any-durable
    elif is_interactive_session; then
        opt_tag_scan=ask
    else
        opt_tag_scan=any-durable
    fi
fi

[[ $# -ge 1 ]] || { usage >&2; exit 1; }

##############################################################################
#### Main

input_index=0
for input in "$@"; do
    ((++input_index))
    process_input "$input" "$input_index"
done

if [[ -n "$opt_json" ]]; then
    if [[ -n "$json_results" ]]; then
        printf '%s\n' "$json_results" | "$JQ" -s '.'
    else
        printf '[]\n'
    fi
fi
